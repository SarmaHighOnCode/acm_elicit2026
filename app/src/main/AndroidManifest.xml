<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 12+ (API 31+) granular Bluetooth permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH_SCAN"
        android:usesPermissionFlags="neverForLocation" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADVERTISE" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- Pre-Android 12 (API ≤ 30) legacy Bluetooth permissions -->
    <uses-permission android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- GPS position for the SOS beacon payload -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- Foreground service keeps BLE alive when the screen is off -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CONNECTED_DEVICE" />

    <!-- Android 13+ requires this to post the foreground notification -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Only requested/used when a node enables Gateway Mode (see GatewaySettings) -->
    <uses-permission android:name="android.permission.SEND_SMS" />

    <!-- Normal permission: lets UplinkMonitor ask ConnectivityManager whether this phone
         actually has validated internet, instead of trusting a settings toggle. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Normal permission (no runtime prompt needed): buzz on newly observed SOS -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- Hard requirement: BLE is the only transport -->
    <uses-feature android:name="android.hardware.bluetooth_le" android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Setu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Setu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <service
            android:name=".service.SetuService"
            android:exported="false"
            android:foregroundServiceType="connectedDevice" />
    </application>
</manifest>
